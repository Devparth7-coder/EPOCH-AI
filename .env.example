# ---------------------------------------------------------------------------
# EPOCH AI — environment configuration
# Copy to backend/.env (or set as service env vars). NEVER commit real keys.
# ---------------------------------------------------------------------------

# --- app -------------------------------------------------------------------
ENVIRONMENT=local                 # local | staging | production
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- database --------------------------------------------------------------
# Zero-config default (SQLite file). For production use Neon/Render Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL=sqlite:///./epoch.db

# --- model gateway: Bifrost by Maxim AI (OpenAI-compatible) ----------------
# When BIFROST_API_KEY is set it becomes the single routing point for all models.
BIFROST_BASE_URL=https://gateway.getbifrost.ai
BIFROST_API_KEY=

# Direct providers (used when Bifrost is not configured)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Model routing
MODEL_PRIMARY=openai/gpt-4o-mini
MODEL_UTILITY=openai/gpt-4o-mini
MODEL_FALLBACK=google/gemini-2.0-flash
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# --- live research ---------------------------------------------------------
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=6
RESEARCH_MAX_CLAIMS=12
RESEARCH_CONCURRENCY=4

# --- cost model (USD per 1K tokens — override for your contract) -----------
PRICE_INPUT_PER_1K=0.00015
PRICE_OUTPUT_PER_1K=0.0006
TAVILY_PRICE_PER_SEARCH=0.008

# --- limits & security -----------------------------------------------------
MAX_INPUT_CHARS=20000
MAX_URL_FETCH_BYTES=2000000
RATE_LIMIT_PER_MINUTE=60
ALLOW_PRIVATE_NETWORKS=false      # keep false in production (SSRF guard)
JOB_TIMEOUT_SECONDS=180
